diff --git a/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp b/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp
index 8b80eb4e6b..85d7989d7c 100644
--- a/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp
+++ b/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp
@@ -30,10 +30,58 @@
 #include "CryptoKeyRaw.h"
 #include "ExceptionOr.h"
 #include "OpenSSLUtilities.h"
+#if defined(WK_WINUWP)
+// Apotheosis: <openssl/hkdf.h> 和那个一次性的 HKDF() 函数是 BoringSSL 专有的 —— 这套后端是
+// 照 BoringSSL 写的。本 port 链的是真 OpenSSL 3.x(TLS 也用它),没有这个头,只有 RFC 5869 的
+// EVP_PKEY_HKDF 派生接口(<openssl/kdf.h>,OpenSSL 1.1.0 起)。下面用它重写,算法本身不变。
+#include <openssl/kdf.h>
+#include <openssl/evp.h>
+#else
 #include <openssl/hkdf.h>
+#endif
 
 namespace WebCore {
 
+#if defined(WK_WINUWP)
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmHKDF::platformDeriveBits(const CryptoAlgorithmHkdfParams& parameters, const CryptoKeyRaw& key, size_t length)
+{
+    auto algorithm = digestAlgorithm(parameters.hashIdentifier);
+    if (!algorithm)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto ctx = EvpPKeyCtxPtr(EVP_PKEY_CTX_new_id(EVP_PKEY_HKDF, nullptr));
+    if (!ctx)
+        return Exception { ExceptionCode::OperationError };
+
+    if (EVP_PKEY_derive_init(ctx.get()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+    if (EVP_PKEY_CTX_set_hkdf_md(ctx.get(), algorithm) <= 0)
+        return Exception { ExceptionCode::OperationError };
+
+    // salt/info 允许为空。OpenSSL 对长度 0 的 set1_hkdf_salt 会报错,所以空的就不设
+    // (不设 = 全零 salt,正是 RFC 5869 对 salt 缺省的定义)。
+    auto salt = parameters.saltVector();
+    if (salt.size() && EVP_PKEY_CTX_set1_hkdf_salt(ctx.get(), salt.span().data(), salt.size()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+
+    auto keyData = key.key();
+    if (EVP_PKEY_CTX_set1_hkdf_key(ctx.get(), keyData.span().data(), keyData.size()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+
+    auto info = parameters.infoVector();
+    if (info.size() && EVP_PKEY_CTX_add1_hkdf_info(ctx.get(), info.span().data(), info.size()) <= 0)
+        return Exception { ExceptionCode::OperationError };
+
+    Vector<uint8_t> output(length / 8);
+    size_t outputLength = output.size();
+    if (EVP_PKEY_derive(ctx.get(), output.mutableSpan().data(), &outputLength) <= 0)
+        return Exception { ExceptionCode::OperationError };
+    if (outputLength != output.size())
+        return Exception { ExceptionCode::OperationError };
+
+    return output;
+}
+#else
 ExceptionOr<Vector<uint8_t>> CryptoAlgorithmHKDF::platformDeriveBits(const CryptoAlgorithmHkdfParams& parameters, const CryptoKeyRaw& key, size_t length)
 {
     auto algorithm = digestAlgorithm(parameters.hashIdentifier);
@@ -46,5 +94,6 @@ ExceptionOr<Vector<uint8_t>> CryptoAlgorithmHKDF::platformDeriveBits(const Crypt
 
     return output;
 }
+#endif
 
 } // namespace WebCore

+    if (!d->m_user.isEmpty() || !d->m_password.isEmpty()) {
+        d->m_curlRequest->setUserPass(d->m_user, d->m_password);
+        d->m_curlRequest->setAuthenticationScheme(ProtectionSpace::AuthenticationScheme::HTTPBasic);
+    }

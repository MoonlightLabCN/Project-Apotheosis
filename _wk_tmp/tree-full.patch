+static NetworkStorageSession* storageSessionFor(ResourceHandleInternal* d)
+{
+    if (d->m_context) {
+        if (auto* session = d->m_context->storageSession())
+            return session;
+    }
+    return WebCorePortDefaultStorageSession();

+    void notifySeekFinished();
+    void notifyFrameReady();
+    void notifyPlaybackEnded();
+
+    // ---- presentation (engine thread; frame lock taken internally) ----
+    bool ensureFrameBuffers(const IntSize&);
+
+    // ---- decode thread ----
+    void decodeThreadBody();
+    bool openSourceReader(DecoderState&, const String& url);
+    bool configureVideoStream(DecoderState&, unsigned streamIndex, IMFMediaType*);
+    bool configureAudioStream(DecoderState&, unsigned streamIndex, IMFMediaType*);
+    void decodeLoop(DecoderState&);
+    bool decodeOneSample(DecoderState&, bool respectPacing);
+    bool performSeek(DecoderState&, MediaTime);
+    void handleVideoSample(DecoderState&, IMFSample*, LONGLONG timestamp);
+    void handleAudioSample(DecoderState&, IMFSample*, LONGLONG timestamp);
+    void noteEndOfStream(DecoderState&, unsigned streamIndex);
+    void waitUntilDue(MediaTime due);
+    void publishFrame(const uint8_t* pixels, int sourceStride, const IntSize&);
+    // Publish the state a decode-thread failure ends in, atomically and on the engine thread.
+    void postFailure(MediaPlayer::NetworkState, const char* site);
+
+    MediaTime clockNowLocked() const WTF_REQUIRES_LOCK(m_lock);
+
+    ThreadSafeWeakPtr<MediaPlayer> m_player;
+
+    // ------------------------------------------------------------------
+    // Cross-thread state. m_lock guards everything down to m_audioAnchorMedia.
+    // The decode thread holds it only for short critical sections and never
+    // while inside Media Foundation or while notifying MediaPlayer.
+    // ------------------------------------------------------------------
+    mutable Lock m_lock;
+    Condition m_condition;
+    String m_url WTF_GUARDED_BY_LOCK(m_lock);
+    bool m_stopRequested WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_paused WTF_GUARDED_BY_LOCK(m_lock) { true };
+    // Media clock anchor: currentTime == m_clockAnchorMedia + (now - m_clockAnchorWall) * rate.
+    MediaTime m_clockAnchorMedia WTF_GUARDED_BY_LOCK(m_lock);
+    double m_clockAnchorWall WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    MediaTime m_currentTime WTF_GUARDED_BY_LOCK(m_lock);
+    MediaTime m_seekRequest WTF_GUARDED_BY_LOCK(m_lock);
+    bool m_seekPending WTF_GUARDED_BY_LOCK(m_lock) { false };
+    // The producer (not the promise) is what the decode thread settles. NativePromiseProducer
+    // is move-only and its destructor rejects an unsettled promise, so replacing or clearing
+    // it is itself a correct cancellation.
+    std::optional<MediaTimePromise::Producer> m_seekProducer WTF_GUARDED_BY_LOCK(m_lock);
+    MediaTime m_duration WTF_GUARDED_BY_LOCK(m_lock);
+    double m_rate WTF_GUARDED_BY_LOCK(m_lock) { 1.0 };
+    float m_volume WTF_GUARDED_BY_LOCK(m_lock) { 1.0f };
+    bool m_muted WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_eosVideo WTF_GUARDED_BY_LOCK(m_lock) { false };
+    bool m_eosAudio WTF_GUARDED_BY_LOCK(m_lock) { false };
+    int m_audioSampleRate WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    int m_audioChannels WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+    MediaTime m_audioAnchorMedia WTF_GUARDED_BY_LOCK(m_lock);
+
+    // Engine thread only (never touched by the decode thread, so no lock): the buffered
+    // ranges are updated from the engine-thread notifications.
+    PlatformTimeRanges m_buffered;
+
+    // Written by the decode thread, read by the engine thread. Atomics rather than
+    // m_lock because naturalSize()/readyState() are polled on every layout and paint.
+    std::atomic<MediaPlayer::NetworkState> m_networkState { MediaPlayer::NetworkState::Empty };
+    std::atomic<MediaPlayer::ReadyState> m_readyState { MediaPlayer::ReadyState::HaveNothing };
+    std::atomic<bool> m_hasVideo { false };
+    std::atomic<bool> m_hasAudio { false };
+    // Set when the decoder hits end of stream. play() consumes it to restart from the
+    // beginning, which is what the element expects after it has ended.
+    std::atomic<bool> m_reachedEnd { false };
+    std::atomic<int> m_naturalWidth { 0 };
+    std::atomic<int> m_naturalHeight { 0 };
+
+    // ------------------------------------------------------------------
+    // Frame double buffer. The decode thread fills the back buffer and swaps
+    // m_presentBuffer under m_frameLock; paint() holds the same lock across its blit.
+    // Two buffers mean the decoder never writes into the surface Cairo is reading, and
+    // paint never blocks on the decoder for longer than that one blit. Both buffers are
+    // sized once per stream and never reallocated, so the cairo surfaces over them stay
+    // valid.
+    // ------------------------------------------------------------------
+    static constexpr unsigned s_frameBufferCount = 2;
+    mutable Lock m_frameLock;
+    IntSize m_frameSize WTF_GUARDED_BY_LOCK(m_frameLock);
+    Vector<uint8_t> m_frameBuffer[s_frameBufferCount] WTF_GUARDED_BY_LOCK(m_frameLock);
+    RefPtr<cairo_surface_t> m_frameSurface[s_frameBufferCount] WTF_GUARDED_BY_LOCK(m_frameLock);
+    unsigned m_writeBuffer WTF_GUARDED_BY_LOCK(m_frameLock) { 0 };
+    unsigned m_presentBuffer WTF_GUARDED_BY_LOCK(m_frameLock) { 0 };
+    bool m_havePresentableFrame WTF_GUARDED_BY_LOCK(m_frameLock) { false };
+
+    // Decode-thread-only scratch (PCM conversion); only ever touched on that thread.
+    Vector<float> m_scratch;
+
+    // Owned by the decode thread while it runs; destroyed after it is joined.
+    std::unique_ptr<DecoderState> m_decoder;
+    RefPtr<Thread> m_decodeThread;
+};
+
+} // namespace WebCore
+
+#endif // defined(WK_WINUWP)
diff --git a/Source/WebCore/platform/graphics/win/WinUWPMediaBridge.h b/Source/WebCore/platform/graphics/win/WinUWPMediaBridge.h
new file mode 100644
index 0000000000..9718729196
--- /dev/null
+++ b/Source/WebCore/platform/graphics/win/WinUWPMediaBridge.h
@@ -0,0 +1,75 @@
+/*
+ * Apotheosis (WK_WINUWP): the WebCore <-> port contract for media.
+ *
+ * Deliberately tiny and free of MediaPlayer/Media Foundation includes: the platform
+ * layer (port/) implements the sink declared here and reads the diagnostics, and it
+ * must be able to do that without pulling WebCore's media headers into the driver.
+ * MediaPlayerPrivateWinUWP.h includes this header; port/PortMediaAudio.cpp includes it
+ * as <WebCore/WinUWPMediaBridge.h>.
+ *
+ * Direction of the dependency: WebCore declares, port/ implements and installs. The
+ * engine therefore never references a port/ symbol.
+ */
+
+#pragma once
+
+#if defined(WK_WINUWP)
+
+#include <cstdint>
+#include <unknwn.h>
+
+namespace WebCore {
+
+// ---------------------------------------------------------------------------
+// The audio device, as seen from the engine.
+//
+// The engine has no audio device access of its own and the port keeps all device work on
+// the harness side, so decoded PCM is handed to whichever sink port/ installed. With no
+// sink installed every call is a no-op and video still plays.
+//
+// Threading: configure()/reset() are called from the engine thread while the decode loop
+// is parked; pushPCM() and consumedFrames() are called from the decode thread only.
+// pushPCM() must never block for longer than the copy takes, and returns the frames
+// actually queued, so a full queue is back-pressure the decode loop paces itself against
+// instead of dropped audio.
+// ---------------------------------------------------------------------------
+class WinUWPMediaAudioSink {
+public:
+    virtual ~WinUWPMediaAudioSink() = default;
+
+    virtual void configure(int sampleRate, int channels) = 0;
+    virtual void reset() = 0;
+    virtual int pushPCM(const float* interleaved, int frames) = 0;
+    virtual uint64_t consumedFrames() const = 0;
+};
+
+WinUWPMediaAudioSink* winUWPMediaAudioSink();
+void setWinUWPMediaAudioSink(WinUWPMediaAudioSink*);
+
+// ---------------------------------------------------------------------------
+// Diagnostics.
+//
+// A silent media failure on device is the worst outcome — the page cannot see it and the
+// element just stays blank — so the decode path records why it gave up. The driver reads
+// these into stage.txt.
+//
+// The video subtype values are GUID::Data1 of the negotiated media types, which is enough
+// to tell the interesting cases apart (RGB32 = 0x16, NV12 = 0x3231564E, H264 = 0x34363248).
+// ---------------------------------------------------------------------------
+struct WinUWPMediaDiagnostics {
+    static unsigned startedSourceReaders();
+    static unsigned long long framesDecoded();
+    static unsigned long long framesPresented();
+    static unsigned long long pcmFramesPushed();
+    static unsigned long long pcmFramesDropped();
+    static HRESULT lastError();
+    static const char* lastErrorSite();
+    static void recordVideoTypes(unsigned nativeSubtype, unsigned outputSubtype, bool dxvaDisabled);
+    static unsigned nativeVideoSubtype();
+    static unsigned outputVideoSubtype();
+    static bool dxvaDisabled();
+};
+
+} // namespace WebCore
+
+#endif // defined(WK_WINUWP)
diff --git a/Source/cmake/OptionsWinUWP.cmake b/Source/cmake/OptionsWinUWP.cmake
new file mode 100644
index 0000000000..41800d418b
--- /dev/null
+++ b/Source/cmake/OptionsWinUWP.cmake
@@ -0,0 +1,272 @@
+# ============================================================================
+# OptionsWinUWP.cmake  —  WinUWP port (EdgeHTML Reborn)
+# Phase 0: 只编 WTF + JavaScriptCore, CLoop 解释器, 无 JIT, 系统 malloc。
+# 目标: ARM32 (ARMv7 Thumb-2) + Windows 10 Mobile UWP / App Container。
+#
+# 设计要点(基于对 webkitgtk-2.52.4 源码的核对):
+#   * WebKitFeatures.cmake 对 "ARM 且非 Linux" 的默认分支(else, 第115行)已是
+#     JIT=OFF / C_LOOP=ON / USE_SYSTEM_MALLOC=ON / WEBASSEMBLY=OFF —— 正合 Phase 0。
+#   * 故本文件刻意"不"复制 OptionsJSCOnly.cmake 里那句
+#     `if (WIN32) WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC PRIVATE OFF)`,
+#     以保留默认的系统 malloc(避免 bmalloc/libpas 的 VM 适配)。
+#   * App Container 的 WINAPI_FAMILY_APP / WindowsApp.lib / VirtualAllocFromApp 等
+#     由 Toolchain-ARM32-UWP.cmake 处理, 不在此文件。
+# ============================================================================
+
+find_package(Threads REQUIRED)
+
+# 编译器 flags。Path B = clang-cl(modern WebKit 唯一可行)。OptionsMSVC.cmake 是
+# clang-cl 专用但硬编码 x86_64(/clang:-masm=att、clang_rt.builtins-x86_64),不能整体 include,
+# 故在此写 ARM 适配的 clang-cl flags。Path A(纯 MSVC cl)分支保留作记录,实际已弃。
+if (COMPILER_IS_CLANG_CL)
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/utf-8>)
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/bigobj>)
+    add_compile_options(/GS /Zc:dllexportInlines-)
+    add_definitions(-D_CRT_SECURE_NO_WARNINGS -D_ENABLE_EXTENDED_ALIGNED_STORAGE)
+    add_link_options(/INCREMENTAL:NO /OPT:REF /OPT:NOICF /STACK:8388608)
+
+    # 关 C++ 异常: clang 的 thumbv7-windows-msvc 后端无法 lower cleanupret(Windows EH),
+    # 开异常(CMake 默认 /EHsc)会触发 "Cannot select: cleanupret" 后端崩溃(exit 70)。
+    # WebKit 本就不用异常(RELEASE_ASSERT 而非 throw),关掉即可。
+    string(REGEX REPLACE "/EH[-a-z]+" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
+    string(REGEX REPLACE "/EH[-a-z]+" "" CMAKE_C_FLAGS   "${CMAKE_C_FLAGS}")
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/EHs-c->)
+    add_definitions(-D_HAS_EXCEPTIONS=0)
+
+    # ARM 的 clang compiler-rt builtins(若 LLVM 预编译包提供; 否则靠 MSVC CRT 的 ARM helper)。
+    # 非 REQUIRED: 找不到就不链(不像 OptionsMSVC 那样对 x86_64 强制)。
+    cmake_path(REMOVE_FILENAME CMAKE_CXX_COMPILER OUTPUT_VARIABLE _CLANG_DIR)
+    string(REGEX MATCH "^[0-9]+" _CLANG_VER ${CMAKE_CXX_COMPILER_VERSION})
+    find_library(CLANG_RT_BUILTINS_ARM
+        NAMES clang_rt.builtins-arm clang_rt.builtins-armhf clang_rt.builtins-thumbv7
+        PATHS "${_CLANG_DIR}/../lib/clang/${_CLANG_VER}/lib/windows"
+        NO_DEFAULT_PATH)
+    if (CLANG_RT_BUILTINS_ARM)
+        link_libraries(${CLANG_RT_BUILTINS_ARM})
+        message(STATUS "WinUWP: 链接 ARM compiler-rt: ${CLANG_RT_BUILTINS_ARM}")
+    else ()
+        message(STATUS "WinUWP: 未找到 ARM clang_rt.builtins, 依赖 MSVC CRT 的 ARM helper")
+    endif ()
+elseif (MSVC)
+    # Path A 残留(纯 MSVC, 已证明编不过 modern WebKit, 仅留作历史)
+    add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/utf-8> $<$<COMPILE_LANGUAGE:C,CXX>:/bigobj>)
+    add_definitions(-D_CRT_SECURE_NO_WARNINGS -D_ENABLE_EXTENDED_ALIGNED_STORAGE)
+    add_link_options(/INCREMENTAL:NO /OPT:REF /OPT:NOICF /STACK:8388608)
+endif ()
+
+add_definitions(-DBUILDING_WINUWP__)
+
+set(PROJECT_VERSION_MAJOR 0)
+set(PROJECT_VERSION_MINOR 1)
+set(PROJECT_VERSION_MICRO 0)
+set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_MICRO})
+
+WEBKIT_OPTION_BEGIN()
+
+# JSC 构建成静态库, 便于直接打包进 appx
+WEBKIT_OPTION_DEFINE(ENABLE_STATIC_JSC "Build JavaScriptCore as a static library." PUBLIC ON)
+WEBKIT_OPTION_DEFINE(USE_LIBBACKTRACE  "Enable usage of libbacktrace."            PUBLIC OFF)
+
+# 显式锁定解释器路线(ARM32-Win 默认已如此, 这里写明以自文档化、防回归)。
+# 注: WebKitFeatures 里 ENABLE_C_LOOP 与 ENABLE_JIT / SAMPLING_PROFILER / WEBASSEMBLY
+#     互为 WEBKIT_OPTION_CONFLICT, 故设 C_LOOP=ON 即自动排除那三者。
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP           PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_JIT             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_REMOTE_INSPECTOR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_API_TESTS       PRIVATE OFF)
+
+# ---- Phase 1 WebCore: 最小特性集(软件渲染, 无媒体/GPU/网络重特性) ----
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBXR             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GPU_PROCESS       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_OFFSCREEN_CANVAS  PRIVATE OFF)
+# Apotheosis/WK_WINUWP: WEBGL/WEBGPU 必须在 WEBKIT_OPTION_END() 之前用 DEFAULT_PORT_VALUE 关,
+# 否则(像下方 L130 那样在 END() 之后 set())只改普通变量、改不到 cache option,cache 仍取
+# WebKitFeatures 默认 ON(WEBGL),使 FEATURE_DEFINES 带 ENABLE_WEBGL → IDL 生成 5-类型
+# RenderingContext union(含 WebGL*RenderingContext),与 C++ 侧 #if ENABLE(WEBGL) 的 3-类型
+# variant 不一致 → incomplete type / 缺 toJS / no viable conversion。
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGL             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGPU            PRIVATE OFF)
+# Apotheosis: WebCodecs 关掉(basic HTML 不需要)。注:ENABLE_CSS_TYPED_OM 在 2.52.4 不是 feature
+# flag(Typed OM 常开,无法关),而 CSSMathValue/CSSStyleValue 等 Typed OM binding 的复杂 union
+# variant 是 clang thumbv7 "cannot mangle this pack expansion" 墙的主要触发源 —— 故特性裁剪绕不过
+# 这堵墙,需走"换 LLVM / 重构 switchOn"方向(见 MORNING-STATUS)。
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_CODECS        PRIVATE OFF)
+# Apotheosis: media backend is being implemented on the media-mf branch.
+# ENABLE_VIDEO is ON so the WebCore media stack (MediaPlayer/HTMLMediaElement/
+# MediaControlsHost) is actually compiled; USE_MEDIA_FOUNDATION stays OFF so the
+# desktop MF presenter (HWND/EVR/D3D9/DComp) is never pulled in. The WinUWP
+# player is registered from MediaPlayer.cpp behind WK_WINUWP instead.
+# NOTE: flipping this forces a full WebCore rebuild (config.h changes).
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO             PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUDIO         PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SOURCE      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STREAM      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_RTC           PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_LEGACY_ENCRYPTED_MEDIA PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ENCRYPTED_MEDIA   PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPEECH_SYNTHESIS  PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DRAG_SUPPORT      PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CONTEXT_MENUS     PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FULLSCREEN_API    PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GAMEPAD           PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GEOLOCATION       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DEVICE_ORIENTATION PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_NOTIFICATIONS     PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPELLCHECK        PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_RESOURCE_USAGE    PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_XSLT              PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MATHML            PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_PAYMENT_REQUEST   PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUTHN         PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CONTENT_EXTENSIONS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MHTML             PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBDRIVER         PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MINIBROWSER       PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA                 PRIVATE OFF)  # 关键: 选 Cairo 分支
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2               PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_AVIF                PRIVATE OFF)
+
+WEBKIT_OPTION_END()
+
+# 事件循环: 通用实现(不依赖 GLib)
+set(ALL_EVENT_LOOP_TYPES Generic)
+set(DEFAULT_EVENT_LOOP_TYPE "Generic")
+set(EVENT_LOOP_TYPE ${DEFAULT_EVENT_LOOP_TYPE} CACHE STRING "Event loop impl (one of ${ALL_EVENT_LOOP_TYPES})")
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+
+# Phase 1: 开 WebCore(WTF + JSC + WebCore);WebKit/Legacy 层暂不建(直接驱动 WebCore)
+set(ENABLE_WEBCORE         ON)
+set(ENABLE_WEBKIT_LEGACY   OFF)
+set(ENABLE_WEBKIT          OFF)
+set(ENABLE_WEBINSPECTORUI  OFF)
+# ENABLE_WEBGL/ENABLE_WEBGPU 已上移到 WEBKIT_OPTION_END() 之前用 WEBKIT_OPTION_DEFAULT_PORT_VALUE
+# 关闭(此处 set() 在 END() 之后只改普通变量、改不到 cache,是之前两侧不一致的根因,故删除)。
+set(ENABLE_API_TESTS       OFF)
+
+# ARM 反汇编器(capstone): 无 JIT 不需要。且其 CMakeLists 用了 CMake 4.x 已移除的
+# cmake_policy(CMP0048 OLD) → 直接关掉, 避免引入该子目录。
+SET_AND_EXPOSE_TO_BUILD(USE_CAPSTONE FALSE)
+set(ENABLE_DISASSEMBLER OFF)
+
+# 静态库时无需把 WTF/bmalloc 拆成 OBJECT
+if (NOT ENABLE_STATIC_JSC)
+    set(JavaScriptCore_LIBRARY_TYPE SHARED)
+    set(bmalloc_LIBRARY_TYPE OBJECT)
+    set(WTF_LIBRARY_TYPE OBJECT)
+endif ()
+
+# ---- Windows / Win10M 编译宏 ----
+add_definitions(-D_WINDOWS)
+# Win10M 1709 (build 15254) = NTDDI_WIN10_RS3。锁低 NTDDI, 防止编进设备上不存在的新 API。
+add_definitions(-DNTDDI_VERSION=0x0A000004 -D_WIN32_WINNT=0x0A00)
+add_definitions(-DNOMINMAX -DUNICODE -D_UNICODE -DNOCRYPT)
+add_definitions(-D_CRT_NONSTDC_NO_DEPRECATE)
+add_definitions(-D_SILENCE_CXX23_DENORM_DEPRECATION_WARNING)
+
+if (DEFINED ENV{WEBKIT_IGNORE_PATH})
+    set(CMAKE_IGNORE_PATH $ENV{WEBKIT_IGNORE_PATH})
+endif ()
+
+# 单配置(Ninja)输出目录对齐
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG   "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG   "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG   "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
+set(CMAKE_DISABLE_PRECOMPILE_HEADERS OFF)
+
+# ---- ICU(由 vcpkg arm-uwp triplet 提供)----
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+
+# ============================================================================
+# Phase 1: WebCore 后端开关 + 依赖。网络栈(Curl/OpenSSL/PSL)本轮延后到 Phase 1b,
+# 见 E:\Apotheosis\NIGHT-LOG-*.md。目标先让 WebCore configure + 编译渲染主体。
+# ============================================================================
+if (ENABLE_WEBCORE)
+    SET_AND_EXPOSE_TO_BUILD(USE_CAIRO          ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_FREETYPE       ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_FONTCONFIG     ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ       ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_SYSTEM_MALLOC  ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_THEME_ADWAITA  ON)
+    # Apotheosis (M4): opt-in baseline JIT. wtf/PlatformEnable.h forces ENABLE_JIT=0 on every
+# 32-bit target except ARMv7 Linux, so ENABLE_JIT=ON is inert by itself; with
+# WK_WINUWP_JIT the header keeps the cmake value. (Re-wired during the 2.54 rebase:
+# the gate lives in wtf/PlatformEnable.h and needs this define.)
+if (APOTHEOSIS_JIT)
+    add_definitions(-DWK_WINUWP_JIT=1)
+endif ()
+
+if (APOTHEOSIS_GPU)
+        # GPU 路径1:TextureMapper 同步合成(GraphicsLayerTextureMapper,无需 Coordinated/Nicosia/WC)
+        # + ANGLE。复用预编译 NuGet ANGLE.WindowsStore(arm32 UWP)做 IMPORTED target,不编 in-tree ANGLE。
+        SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER                ON)
+        SET_AND_EXPOSE_TO_BUILD(USE_GRAPHICS_LAYER_TEXTURE_MAPPER ON)
+        SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS         OFF)
+        SET_AND_EXPOSE_TO_BUILD(USE_GRAPHICS_LAYER_WC            OFF)
+        SET_AND_EXPOSE_TO_BUILD(USE_ANGLE                        ON)
+        set(USE_ANGLE_EGL ON)
+        set(_APO_ANGLE "E:/Apotheosis/angle")
+        if (NOT TARGET ANGLE::GLES)
+            add_library(ANGLE::GLES UNKNOWN IMPORTED GLOBAL)
+            set_target_properties(ANGLE::GLES PROPERTIES
+                IMPORTED_LOCATION "${_APO_ANGLE}/arm/libGLESv2.lib"
+                INTERFACE_INCLUDE_DIRECTORIES "${_APO_ANGLE}/include")
+        endif ()
+        if (NOT TARGET ANGLE::EGL)
+            add_library(ANGLE::EGL UNKNOWN IMPORTED GLOBAL)
+            set_target_properties(ANGLE::EGL PROPERTIES
+                IMPORTED_LOCATION "${_APO_ANGLE}/arm/libEGL.lib"
+                INTERFACE_INCLUDE_DIRECTORIES "${_APO_ANGLE}/include")
+        endif ()
+    else ()
+        # 加速合成路径全关(软件渲染;避免引用 TextureMapper / ANGLE / coordinated-graphics 符号)
+        SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER       OFF)
+        SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS OFF)
+        SET_AND_EXPOSE_TO_BUILD(USE_ANGLE                OFF)
+    endif ()
+    # Apotheosis: leave this off until the UWP SourceReader backend replaces
+    # the desktop EVR/D3D9 implementation in the WebCore source list.
+    SET_AND_EXPOSE_TO_BUILD(USE_MEDIA_FOUNDATION     OFF)
+    SET_AND_EXPOSE_TO_BUILD(USE_LCMS                  OFF)   # 不编 lcms2 色彩管理
+    SET_AND_EXPOSE_TO_BUILD(USE_JPEGXL                OFF)   # 不编 libjxl
+    SET_AND_EXPOSE_TO_BUILD(USE_AVIF                  OFF)   # 不编 libavif(双保险)
+    # 网络/加密后端(Phase 1b,2026-06-15):curl ResourceLoader + OpenSSL 3.6.3 TLS(TLS 1.3,
+    # 替 Win10M Schannel 只到 1.2)。库由 vcpkg curl[openssl]:arm-uwp 提供。USE_OPENSSL=ON 是 curl 的
+    # TLS/crypto 后端宏;WebCrypto(crypto/openssl 的 18 个文件)经 PlatformWinUWP 维持不 include
+    # OpenSSL.cmake 来排除(本阶段只要网络,不要 window.crypto.subtle)。
+    SET_AND_EXPOSE_TO_BUILD(USE_CURL           ON)
+    SET_AND_EXPOSE_TO_BUILD(USE_OPENSSL        ON)
+

+
+MediaTime MediaPlayerPrivateWinUWP::clockNowLocked() const
+{
+    if (m_clockAnchorWall <= 0)
+        return m_clockAnchorMedia;
+
+    double elapsed = MonotonicTime::now().secondsSinceEpoch().value() - m_clockAnchorWall;
+    if (elapsed < 0)
+        elapsed = 0;
+
+    MediaTime now = m_clockAnchorMedia + MediaTime::createWithDouble(elapsed * m_rate);
+    if (m_duration > MediaTime::zeroTime() && now > m_duration)
+        now = m_duration;
+    return now;
+}

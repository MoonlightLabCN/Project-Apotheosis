diff --git a/Source/WebCore/PAL/pal/PlatformWinUWP.cmake b/Source/WebCore/PAL/pal/PlatformWinUWP.cmake
new file mode 100644
index 0000000000..4a13eed0da
--- /dev/null
+++ b/Source/WebCore/PAL/pal/PlatformWinUWP.cmake
@@ -0,0 +1,24 @@
+# ============================================================================
+# PAL platform sources for the Windows 10 Mobile / App Container port.
+#
+# WHY THIS FILE EXISTS AT ALL: without it PAL is built from its cross-platform
+# Sources.txt only, which contains no Clock implementation - that went unnoticed
+# for the whole life of the port because nothing referenced PAL::Clock while
+# ENABLE_VIDEO was off. Turning <video> on pulls in MediaTime/PlatformTimeRanges
+# users that call PAL::Clock::create(), and the driver link then failed with:
+#
+#     undefined symbol: PAL::Clock::create(void)
+#
+# ClockGeneric is the portable std::chrono implementation; the desktop Win port
+# (PlatformWin.cmake) and the Cocoa port both use exactly this file, and there is
+# nothing Win32-specific about it. The other three entries of PlatformWin.cmake are
+# deliberately NOT copied here:
+#   crypto/openssl/CryptoDigestOpenSSL.cpp - PAL::CryptoDigest is provided by
+#       port/stubs-crypto.cpp for this port (see the note in WebCore/PlatformWinUWP.cmake);
+#       adding it here would duplicate every PAL crypto symbol.
+#   system/win/SoundWin.cpp - desktop system sounds (PlaySound/MMSystem).
+#   text/KillRing.cpp - Win32 clipboard-backed kill ring; the port has no clipboard there.
+# ============================================================================
+list(APPEND PAL_SOURCES
+    system/ClockGeneric.cpp
+)
diff --git a/Source/WebCore/PlatformWinUWP.cmake b/Source/WebCore/PlatformWinUWP.cmake

+/*
+ * Apotheosis (WK_WINUWP): Windows 10 Mobile / App Container media backend.
+ * See MediaPlayerPrivateWinUWP.h for why this exists instead of upstream's
+ * MediaPlayerPrivateMediaFoundation (which is an EVR/D3D9/HWND desktop presenter).
+ *
+ * Decode is Media Foundation's SourceReader; presentation is the port's existing
+ * Cairo / TextureMapper path, so neither present route needed a new hook.
+ *
+ * Threading, restated because it is the whole design:
+ *   engine thread : everything HTMLMediaElement can reach; owns the frame buffer swap,
+ *                   the buffered ranges, and every MediaPlayer notification.
+ *   decode thread : everything Media Foundation plus the media clock. It never calls
+ *                   MediaPlayer; it hands work back with callOnMainThread().
+ */
+
+#include "config.h"
+#include "MediaPlayerPrivateWinUWP.h"
+
+#if defined(WK_WINUWP) && ENABLE(VIDEO)
+
+#include "BString.h"
+#include "COMPtr.h"
+#include "ContentType.h"
+#include "DestinationColorSpace.h"
+#include "GraphicsContext.h"
+#include "ImagePaintingOptions.h"
+#include "IntSize.h"
+#include "MediaPlayer.h"
+#include "NativeImage.h"
+#include "PlatformMediaDecodingType.h"
+#include "PlatformTimeRanges.h"
+#include "RefPtrCairo.h"
+#include <cairo.h>
+#include <mfapi.h>
+#include <mfidl.h>
+#include <mfreadwrite.h>
+#include <Mferror.h>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <wtf/MainThread.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/text/ASCIILiteral.h>
+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(MediaPlayerPrivateWinUWP);
+
+// Media Foundation reports timestamps in 100-nanosecond units.
+static constexpr uint32_t tenMegahertz = 10000000;
+
+// How far ahead of the media clock a decoded frame may be before we hold it back.
+// Frames inside this window are presented immediately; the window absorbs the jitter
+// of a 60 Hz present tick against a 30 fps source.
+static constexpr double presentationLeadSeconds = 0.005;
+// Upper bound on one decode-thread sleep, so stop/pause requests are noticed promptly.
+static constexpr double maximumSleepSeconds = 0.020;
+// How long the decode loop parks when there is nothing to do.
+static constexpr Seconds idleParkInterval { 50_ms };
+
+// ===========================================================================
+// Process-wide diagnostics (read by the driver -> stage.txt)
+// ===========================================================================
+namespace {
+
+std::atomic<unsigned> g_startedSourceReaders { 0 };
+std::atomic<unsigned long long> g_framesDecoded { 0 };
+std::atomic<unsigned long long> g_framesPresented { 0 };
+std::atomic<unsigned long long> g_pcmFramesPushed { 0 };
+std::atomic<unsigned long long> g_pcmFramesDropped { 0 };
+std::atomic<long> g_lastError { 0 };
+std::atomic<const char*> g_lastErrorSite { nullptr };
+std::atomic<unsigned> g_nativeVideoSubtype { 0 };
+std::atomic<unsigned> g_outputVideoSubtype { 0 };
+std::atomic<bool> g_dxvaDisabled { false };
+std::atomic<WinUWPMediaAudioSink*> g_audioSink { nullptr };
+
+void recordError(HRESULT hr, const char* site)
+{
+    if (FAILED(hr)) {
+        g_lastError.store(static_cast<long>(hr));
+        g_lastErrorSite.store(site);
+    }
+}
+
+// Sleep, but never for longer than maximumSleepSeconds: every wait in the decode loop
+// is a place where a stop request has to stay answerable.
+void sleepForSeconds(double seconds)
+{
+    if (seconds <= 0)
+        return;
+    // WTF::sleep(Seconds) is the portable form; there is no Thread::sleep in this WTF.
+    WTF::sleep(Seconds { seconds > maximumSleepSeconds ? maximumSleepSeconds : seconds });
+}
+
+// Containers Win10 Mobile 15254 actually has decoders for. WebM is deliberately absent:
+// Windows 10 Mobile never shipped a VP8/VP9 decoder, so claiming support would leave the
+// element waiting for frames that can never arrive (which is exactly the failure mode
+// this whole line of work exists to remove).
+HashSet<String>& winUWPMediaSupportedTypes()
+{
+    static NeverDestroyed<HashSet<String>> cache = [] {
+        HashSet<String> types;
+        const ASCIILiteral containers[] = {
+            "video/mp4"_s,
+            "audio/mp4"_s,
+            "video/x-m4v"_s,
+            "audio/x-m4a"_s,
+            "video/quicktime"_s,
+            "audio/aac"_s,
+            "audio/mpeg"_s,
+            "audio/mp3"_s,
+            "audio/wav"_s,
+            "audio/x-wav"_s,
+            "video/x-ms-wmv"_s,
+            "audio/x-ms-wma"_s,
+            "video/x-msvideo"_s,
+            "video/3gpp"_s,
+            "audio/3gpp"_s,
+            "video/3gpp2"_s,
+            "audio/3gpp2"_s,
+        };
+        for (auto& container : containers)
+            types.add(String { container });
+        return types;
+    }();
+    return cache.get();
+}

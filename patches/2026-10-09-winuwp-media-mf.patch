+void WinUWPMediaDiagnostics::recordVideoTypes(unsigned nativeSubtype, unsigned outputSubtype, bool dxvaDisabled)
+{
+    g_nativeVideoSubtype.store(nativeSubtype);
+    g_outputVideoSubtype.store(outputSubtype);
+    g_dxvaDisabled.store(dxvaDisabled);
+}
+
+WinUWPMediaAudioSink* winUWPMediaAudioSink()
+{
+    return g_audioSink.load();
+}
+
+void setWinUWPMediaAudioSink(WinUWPMediaAudioSink* sink)
+{
+    // Installed from the driver before any media element exists, so decode threads that
+    // read it later always observe a fully constructed sink.
+    g_audioSink.store(sink);
+}
+
+// ===========================================================================
+// Media Foundation lifetime
+// ===========================================================================
+namespace {
+
+bool ensureMediaFoundationStarted()
+{
+    static std::once_flag once;
+    static bool started = false;
+    std::call_once(once, [] {
+        // MFSTARTUP_LITE skips the media pipeline (presentation) side: the SourceReader
+        // needs only the platform, the source resolver and the codecs.
+        HRESULT hr = ::MFStartup(MF_VERSION, MFSTARTUP_LITE);
+        if (SUCCEEDED(hr))
+            started = true;
+        else
+            recordError(hr, "MFStartup");
+    });
+    return started;
+}
+
+// Media Foundation needs COM on every thread that touches it. The decode thread is
+// ours, so it initializes an MTA and tears it down again; the engine thread is left
+// exactly as it was.
+class ScopedThreadComInitialization {
+public:
+    ScopedThreadComInitialization()
+        : m_hr(::CoInitializeEx(nullptr, COINIT_MULTITHREADED))
+    {
+    }
+    ~ScopedThreadComInitialization()
+    {
+        // Only the call that actually initialized the apartment may uninitialize it.
+        if (m_hr == S_OK || m_hr == S_FALSE)
+            ::CoUninitialize();
+    }
+    // RPC_E_CHANGED_MODE means a different apartment model is already installed on this
+    // thread; Media Foundation works from either, so it is not a failure for us.
+    bool ok() const { return SUCCEEDED(m_hr) || m_hr == RPC_E_CHANGED_MODE; }
+    HRESULT result() const { return m_hr; }
+
+private:
+    HRESULT m_hr { E_FAIL };
+};
+
+} // anonymous namespace
+
+// ===========================================================================
+// Per-stream decode state. Owned by the decode thread; destroyed after it is joined.
+// ===========================================================================
+struct MediaPlayerPrivateWinUWP::DecoderState {
+    COMPtr<IMFSourceReader> reader;
+
+    bool hasVideo { false };
+    bool hasAudio { false };
+    // The reader only reports *real* stream indices from ReadSample(ANY_STREAM), so the
+    // configured streams are tracked by their real indices (see openSourceReader).
+    unsigned videoStreamIndex { 0 };
+    unsigned audioStreamIndex { 0 };
+    int videoStride { 0 };
+    IntSize videoSize;
+    bool videoIsBottomUp { false };
+    bool audioIsFloat { true };
+    bool dxvaDisabled { false };
+    // Set once every selected stream has reported end of stream.
+    bool eos { false };
+    // Set when the reader reports a hard error: the decode loop parks on this instead of
+    // retrying a reader that will never produce a sample again.
+    bool failed { false };
+};
+
+// ===========================================================================
+// Construction / teardown
+// ===========================================================================
+
+MediaPlayerPrivateWinUWP::MediaPlayerPrivateWinUWP(MediaPlayer& player)
+    : m_player(player)
+{
+}
+
+MediaPlayerPrivateWinUWP::~MediaPlayerPrivateWinUWP()
+{
+    stopDecodeThread();
+}
+
+void MediaPlayerPrivateWinUWP::startDecodeThreadIfNeeded()
+{
+    if (m_decodeThread)
+        return;
+
+    m_decoder = makeUniqueWithoutFastMallocCheck<DecoderState>();
+    m_decodeThread = Thread::create("WinUWPMediaDecode"_s, [this] {
+        decodeThreadBody();
+    });
+}
+
+void MediaPlayerPrivateWinUWP::stopDecodeThread()
+{
+    RefPtr<Thread> thread;
+    {
+        Locker locker { m_lock };
+        m_stopRequested = true;
+        m_seekPending = false;
+        // Settling (rather than dropping) makes the cancellation explicit; the producer's own
+        // destructor would reject an unsettled promise anyway.
+        if (m_seekProducer) {
+            m_seekProducer->reject(PlatformMediaError::Cancelled);
+            m_seekProducer.reset();
+        }
+        thread = m_decodeThread;
+        m_condition.notifyAll();
+    }
+
+    if (thread) {
+        thread->waitForCompletion();
+        Locker locker { m_lock };
+        m_decodeThread = nullptr;
+    }
+
+    // Only safe once the decode thread is gone: the state (and the Media Foundation
+    // objects inside it) is otherwise still in use.
+    m_decoder = nullptr;
+}
+
+// ===========================================================================
+// Load / transport
+// ===========================================================================
+
+void MediaPlayerPrivateWinUWP::load(const String& url)
+{
+    cancelLoad();
+
+    m_buffered.clear();
+
+    {
+        Locker locker { m_lock };
+        m_url = url;
+        m_stopRequested = false;
+        // Media starts paused: HTMLMediaElement drives play() once it has metadata.
+        m_paused = true;
+        m_seekPending = false;
+        m_seekProducer.reset();
+        m_eosVideo = false;
+        m_eosAudio = false;
+        m_clockAnchorMedia = MediaTime::zeroTime();
+        m_clockAnchorWall = 0;
+        m_currentTime = MediaTime::zeroTime();
+        m_duration = MediaTime::zeroTime();
+        m_audioSampleRate = 0;
+        m_audioChannels = 0;
+        m_audioAnchorMedia = MediaTime::zeroTime();
+    }
+
+    m_networkState.store(MediaPlayer::NetworkState::Loading);
+    m_readyState.store(MediaPlayer::ReadyState::HaveNothing);
+    m_hasVideo.store(false);
+    m_hasAudio.store(false);
+    m_naturalWidth.store(0);
+    m_naturalHeight.store(0);
+    m_reachedEnd.store(false);
+
+    if (auto sink = winUWPMediaAudioSink())
+        sink->reset();
+
+    startDecodeThreadIfNeeded();
+
+    if (auto player = m_player.get())
+        player->networkStateChanged();
+}
+
+void MediaPlayerPrivateWinUWP::cancelLoad()
+{
+    stopDecodeThread();
+}
+
+void MediaPlayerPrivateWinUWP::play()
+{
+    bool restartFromEnd = m_reachedEnd.exchange(false);
+
+    {
+        Locker locker { m_lock };
+        if (!m_paused && !restartFromEnd)
+            return;
+
+        m_paused = false;
+        // Re-anchor instead of catching up: wall time that passed while paused must not
+        // be charged to the media timeline.
+        m_clockAnchorMedia = m_currentTime;
+        m_clockAnchorWall = MonotonicTime::now().secondsSinceEpoch().value();
+        m_audioAnchorMedia = m_currentTime;
+
+        if (restartFromEnd) {
+            // play() on an already-ended element restarts it, which means seeking back to
+            // the beginning; the decode loop picks this up and clears the end-of-stream
+            // state as part of the seek.
+            m_seekRequest = MediaTime::zeroTime();
+            m_seekPending = true;
+            m_currentTime = MediaTime::zeroTime();
+            m_clockAnchorMedia = MediaTime::zeroTime();
+        }
+
+        m_condition.notifyAll();
+    }
+
+    if (auto player = m_player.get())
+        player->playbackStateChanged();
+}
+
+void MediaPlayerPrivateWinUWP::pause()
+{
+    {
+        Locker locker { m_lock };
+        if (m_paused)
+            return;
+        m_currentTime = clockNowLocked();
+        m_paused = true;
+    }
+
+    if (auto player = m_player.get())
+        player->playbackStateChanged();
+}
+
+void MediaPlayerPrivateWinUWP::setRate(float rate)
+{
+    Locker locker { m_lock };
+
+    // The spec makes a zero rate mean paused, and HTMLMediaElement relies on the player
+    // to be the one that actually stops the clock.
+    if (rate == 0) {
+        m_currentTime = clockNowLocked();
+        m_paused = true;
+        return;
+    }
+
+    MediaTime now = m_paused ? m_currentTime : clockNowLocked();
+    m_currentTime = now;
+    m_clockAnchorMedia = now;
+    m_clockAnchorWall = MonotonicTime::now().secondsSinceEpoch().value();
+    m_rate = rate < 0 ? 1.0 : rate;   // reverse playback is not implemented
+}
+
+Ref<MediaTimePromise> MediaPlayerPrivateWinUWP::seekToTarget(const SeekTarget& target)
+{
+    // The producer stays on this side (the decode thread settles it); the promise goes back
+    // to the element. VideoDecoder.cpp uses the same split.
+    MediaTimePromise::Producer producer;
+    Ref<MediaTimePromise> promise = producer.promise();
+
+    Locker locker { m_lock };
+
+    MediaTime time = target.time;
+    if (time < MediaTime::zeroTime())
+        time = MediaTime::zeroTime();
+    if (m_duration > MediaTime::zeroTime() && time > m_duration)
+        time = m_duration;
+
+    // Nothing to steer when no decode thread is running (not loaded, or loading failed):
+    // answer immediately rather than leaving the element waiting for a seek that no thread
+    // will ever perform.
+    if (!m_decodeThread) {
+        m_currentTime = time;
+        m_clockAnchorMedia = time;
+        m_clockAnchorWall = MonotonicTime::now().secondsSinceEpoch().value();
+        producer.resolve(time);
+        return promise;
+    }
+
+    // A second seek supersedes the first: the element only awaits the newest one.
+    if (m_seekProducer) {
+        m_seekProducer->reject(PlatformMediaError::Cancelled);
+        m_seekProducer.reset();
+    }
+
+    m_seekRequest = time;
+    m_seekPending = true;
+    m_currentTime = time;
+    m_clockAnchorMedia = time;
+    m_clockAnchorWall = MonotonicTime::now().secondsSinceEpoch().value();
+    m_seekProducer.emplace(WTF::move(producer));
+    m_condition.notifyAll();
+
+    return promise;
+}
+
+void MediaPlayerPrivateWinUWP::setVolume(float volume)
+{
+    Locker locker { m_lock };
+    m_volume = volume < 0 ? 0 : (volume > 1 ? 1 : volume);

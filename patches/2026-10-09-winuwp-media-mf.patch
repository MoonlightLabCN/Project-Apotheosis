+
+// ===========================================================================
+// Decode thread -> engine thread notifications
+//
+// Every one of these is called on the decode thread and posts to the main run loop
+// before touching MediaPlayer, because MediaPlayer's notifications reach into the
+// renderer (mediaPlayerRepaint() calls renderer->repaint() directly), which belongs to
+// the engine thread.
+// ===========================================================================
+
+void MediaPlayerPrivateWinUWP::notifyMetadataReady()
+{
+    // WEAK, never strong - see the note in the class declaration. Taking a strong reference on this
+    // (decode) thread is what let the engine thread run ~MediaPlayerPrivateWinUWP(), whose join is
+    // exactly what waits for this thread, and then double-delete the object.
+    ThreadSafeWeakPtr<MediaPlayerPrivateWinUWP> weakThis { *this };
+    callOnMainThread([weakThis] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+
+        // Engine thread: safe to publish the ranges and poke the element.
+        MediaTime duration;
+        {
+            Locker locker { protectedThis->m_lock };
+            duration = protectedThis->m_duration;
+        }
+
+        protectedThis->m_buffered.clear();
+        if (duration > MediaTime::zeroTime())
+            protectedThis->m_buffered.add(MediaTime::zeroTime(), duration);
+
+        protectedThis->setReadyState(MediaPlayer::ReadyState::HaveMetadata);
+
+        if (auto player = protectedThis->m_player.get()) {
+            player->durationChanged();
+            player->sizeChanged();
+        }
+    });
+}
+
+void MediaPlayerPrivateWinUWP::notifyFrameReady()
+{
+    // Called for EVERY decoded video frame, not just the first one. Getting this wrong is
+    // invisible in a build: the element would reach HaveCurrentData, paint once, and then
+    // sit on that frame forever because nothing ever asked the renderer to draw again.
+    ThreadSafeWeakPtr<MediaPlayerPrivateWinUWP> weakThis { *this };
+    callOnMainThread([weakThis] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+
+        const bool firstFrame = protectedThis->m_readyState.load() < MediaPlayer::ReadyState::HaveCurrentData;
+        // Goes through setReadyState so the element actually gets readyStateChanged(); only
+        // firstVideoFrameAvailable() is exclusive to the first frame.
+        protectedThis->setReadyState(MediaPlayer::ReadyState::HaveCurrentData);
+
+        if (auto player = protectedThis->m_player.get()) {
+            if (firstFrame)
+                player->firstVideoFrameAvailable();
+            player->repaint();
+        }
+    });
+}
+
+void MediaPlayerPrivateWinUWP::notifySeekFinished()
+{
+    ThreadSafeWeakPtr<MediaPlayerPrivateWinUWP> weakThis { *this };
+    callOnMainThread([weakThis] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+
+        MediaTime duration;
+        {
+            Locker locker { protectedThis->m_lock };
+            duration = protectedThis->m_duration;
+        }
+
+        protectedThis->m_buffered.clear();
+        if (duration > MediaTime::zeroTime())
+            protectedThis->m_buffered.add(MediaTime::zeroTime(), duration);
+
+        protectedThis->setReadyState(MediaPlayer::ReadyState::HaveCurrentData);
+
+        if (auto player = protectedThis->m_player.get())
+            player->repaint();
+    });
+}
+
+void MediaPlayerPrivateWinUWP::notifyPlaybackEnded()
+{
+    ThreadSafeWeakPtr<MediaPlayerPrivateWinUWP> weakThis { *this };
+    callOnMainThread([weakThis] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+
+        if (auto player = protectedThis->m_player.get())
+            player->playbackStateChanged();
+    });
+}
+
+void MediaPlayerPrivateWinUWP::postFailure(MediaPlayer::NetworkState state, const char* site)
+{
+    recordError(E_FAIL, site);
+
+    // The state is stored immediately so a poll on the engine thread sees it even before
+    // the notification below is serviced.
+    m_networkState.store(state);
+    m_readyState.store(MediaPlayer::ReadyState::HaveNothing);
+    {
+        Locker locker { m_lock };
+        m_paused = true;
+    }
+
+    ThreadSafeWeakPtr<MediaPlayerPrivateWinUWP> weakThis { *this };
+    callOnMainThread([weakThis, state] {
+        RefPtr protectedThis = weakThis.get();
+        if (!protectedThis)
+            return;
+
+        protectedThis->setNetworkState(state);
+    });
+}
+
+// ===========================================================================
+// Frame buffers / painting
+// ===========================================================================
+
+bool MediaPlayerPrivateWinUWP::ensureFrameBuffers(const IntSize& size)
+{
+    if (size.isEmpty())
+        return false;
+
+    Locker locker { m_frameLock };
+
+    if (m_frameSize == size && m_frameSurface[0])
+        return true;
+
+    const int stride = size.width() * 4;
+    const size_t bytes = static_cast<size_t>(stride) * static_cast<size_t>(size.height());
+
+    for (unsigned i = 0; i < s_frameBufferCount; ++i) {
+        // Drop the surface before touching the buffer it points at.
+        m_frameSurface[i] = nullptr;
+        m_frameBuffer[i].resize(bytes);
+        if (m_frameBuffer[i].size() != bytes)
+            return false;
+        memset(m_frameBuffer[i].mutableSpan().data(), 0, bytes);
+
+        // MF "RGB32" is BGRA in memory with an unused high byte, which is exactly what
+        // cairo's CAIRO_FORMAT_RGB24 describes on a little-endian machine; declaring it
+        // opaque also lets the compositor take its fast path.
+        auto surface = adoptRef(cairo_image_surface_create_for_data(m_frameBuffer[i].mutableSpan().data(), CAIRO_FORMAT_RGB24, size.width(), size.height(), stride));
+        if (cairo_surface_status(surface.get()) != CAIRO_STATUS_SUCCESS) {
+            recordError(E_FAIL, "cairo_image_surface_create_for_data");
+            m_frameSurface[i] = nullptr;
+            return false;
+        }
+        m_frameSurface[i] = WTF::move(surface);
+    }
+
+    m_frameSize = size;
+    m_havePresentableFrame = false;
+    m_presentBuffer = 0;
+    m_writeBuffer = 1;
+    return true;
+}
+
+void MediaPlayerPrivateWinUWP::publishFrame(const uint8_t* pixels, int sourceStride, const IntSize& size)
+{
+    if (!pixels || sourceStride == 0)
+        return;
+    if (!ensureFrameBuffers(size))
+        return;
+
+    Locker locker { m_frameLock };
+
+    const int destinationStride = m_frameSize.width() * 4;
+    uint8_t* destination = m_frameBuffer[m_writeBuffer].mutableSpan().data();
+
+    if (sourceStride < 0) {
+        // Bottom-up rows: a negative stride is Media Foundation's way of saying the
+        // buffer starts at the bottom row.
+        const ptrdiff_t rowBytes = static_cast<ptrdiff_t>(-sourceStride);
+        const uint8_t* source = pixels + rowBytes * (size.height() - 1);
+        for (int y = 0; y < size.height(); ++y, source -= rowBytes)
+            memcpy(destination + static_cast<size_t>(y) * destinationStride, source, destinationStride);
+    } else {
+        for (int y = 0; y < size.height(); ++y)
+            memcpy(destination + static_cast<size_t>(y) * destinationStride, pixels + static_cast<size_t>(y) * sourceStride, destinationStride);
+    }
+
+    cairo_surface_mark_dirty(m_frameSurface[m_writeBuffer].get());
+
+    m_presentBuffer = m_writeBuffer;
+    m_writeBuffer = (m_writeBuffer + 1) % s_frameBufferCount;
+    m_havePresentableFrame = true;
+    g_framesDecoded.fetch_add(1);
+}
+
+void MediaPlayerPrivateWinUWP::paint(GraphicsContext& context, const FloatRect& destinationRect)
+{
+    // The frame lock is held across the blit on purpose: the decoder must not write into
+    // the buffer Cairo is reading. The critical section is one bounded blit, and the
+    // decode thread only waits that long before publishing its next frame.
+    Locker locker { m_frameLock };
+
+    if (!m_havePresentableFrame)
+        return;
+    auto& surface = m_frameSurface[m_presentBuffer];
+    if (!surface)
+        return;
+
+    RefPtr<cairo_surface_t> surfaceRef = surface;
+    auto image = NativeImage::create(WTF::move(surfaceRef));
+    if (!image)
+        return;
+
+    FloatRect sourceRect { 0, 0, static_cast<float>(m_frameSize.width()), static_cast<float>(m_frameSize.height()) };
+    context.drawNativeImage(*image, destinationRect, sourceRect, ImagePaintingOptions { });
+    g_framesPresented.fetch_add(1);
+}
+
+// ===========================================================================
+// Decode thread
+// ===========================================================================
+
+void MediaPlayerPrivateWinUWP::decodeThreadBody()
+{
+    if (!ensureMediaFoundationStarted()) {
+        postFailure(MediaPlayer::NetworkState::NetworkError, "MFStartup");
+        return;
+    }
+
+    ScopedThreadComInitialization com;
+    if (!com.ok()) {
+        recordError(com.result(), "CoInitializeEx");
+        postFailure(MediaPlayer::NetworkState::NetworkError, "CoInitializeEx");
+        return;
+    }
+
+    String url;
+    {
+        Locker locker { m_lock };
+        url = m_url.isolatedCopy();
+    }
+
+    if (!openSourceReader(*m_decoder, url)) {
+        postFailure(MediaPlayer::NetworkState::FormatError, "openSourceReader");
+        return;
+    }
+
+    notifyMetadataReady();
+    decodeLoop(*m_decoder);
+
+    // Release the Media Foundation objects on the thread that created them.
+    m_decoder->reader = nullptr;
+}
+
+bool MediaPlayerPrivateWinUWP::openSourceReader(DecoderState& state, const String& url)
+{
+    COMPtr<IMFAttributes> attributes;
+    HRESULT hr = ::MFCreateAttributes(&attributes, 3);
+    if (FAILED(hr)) {
+        recordError(hr, "MFCreateAttributes");
+        return false;
+    }
+
+    // Without this the SourceReader refuses to convert formats and every frame would have
+    // to be negotiated as NV12 and converted by hand. With it, the reader inserts the
+    // Video Processor MFT and can hand back RGB32 directly.
+    attributes->SetUINT32(MF_SOURCE_READER_ENABLE_VIDEO_PROCESSING, TRUE);
+    // MF_SOURCE_READER_DISABLE_DXVA is deliberately left unset: on Win10M the H.264
+    // decoder may hand back GPU-backed samples and let the Video Processor convert them.
+    // App Container DXVA2 availability still has to be confirmed on device; if the
+    // transform fails there, set MF_SOURCE_READER_DISABLE_DXVA = TRUE here (and nothing
+    // else) to force the software decoder.
+    attributes->SetUINT32(MF_SOURCE_READER_DISCONNECT_MEDIASOURCE_ON_SHUTDOWN, TRUE);
+    state.dxvaDisabled = false;
+
+    BString urlString(url);
+    hr = ::MFCreateSourceReaderFromURL(static_cast<LPCWSTR>(urlString), attributes.get(), &state.reader);
+    if (FAILED(hr)) {
+        recordError(hr, "MFCreateSourceReaderFromURL");
+        return false;
+    }
+    g_startedSourceReaders.fetch_add(1);
+
+    // Everything unselected by default; each stream we can actually configure is
+    // selected below.
+    state.reader->SetStreamSelection(MF_SOURCE_READER_ALL_STREAMS, FALSE);
+
+    // Media Foundation's stream indices are not the MF_SOURCE_READER_FIRST_* pseudo
+    // indices: ReadSample(ANY_STREAM) reports the real index, so enumerate the real
+    // streams first and configure those.
+    for (unsigned index = 0; index < 32; ++index) {
+        COMPtr<IMFMediaType> nativeType;
+        hr = state.reader->GetNativeMediaType(index, 0, &nativeType);
+        if (FAILED(hr))
+            break;   // no such stream: end of the stream table
+
+        GUID majorType = GUID_NULL;
+        if (FAILED(nativeType->GetGUID(MF_MT_MAJOR_TYPE, &majorType)))
+            continue;
+
+        if (majorType == MFMediaType_Video && !state.hasVideo)
+            configureVideoStream(state, index, nativeType.get());
+        else if (majorType == MFMediaType_Audio && !state.hasAudio)
+            configureAudioStream(state, index, nativeType.get());
+    }
+
+    if (!state.hasVideo && !state.hasAudio) {
+        recordError(E_FAIL, "no configurable stream");
+        return false;
+    }
+
+    // Duration comes from the presentation descriptor, in 100 ns units.
+    PROPVARIANT duration;
+    PropVariantInit(&duration);
+    if (SUCCEEDED(state.reader->GetPresentationAttribute(MF_SOURCE_READER_MEDIASOURCE, MF_PD_DURATION, &duration)) && duration.vt == VT_UI8) {
+        Locker locker { m_lock };
+        m_duration = MediaTime(static_cast<int64_t>(duration.uhVal.QuadPart), tenMegahertz);
+    }
+    PropVariantClear(&duration);
+
+    m_hasVideo.store(state.hasVideo);
+    m_hasAudio.store(state.hasAudio);
+    return true;
+}
+
+bool MediaPlayerPrivateWinUWP::configureVideoStream(DecoderState& state, unsigned streamIndex, IMFMediaType* nativeType)
+{
+    UINT32 width = 0;
+    UINT32 height = 0;
+    if (FAILED(MFGetAttributeSize(nativeType, MF_MT_FRAME_SIZE, &width, &height)) || !width || !height)
+        return false;
+
+    GUID nativeSubtype = GUID_NULL;
+    nativeType->GetGUID(MF_MT_SUBTYPE, &nativeSubtype);
+
+    COMPtr<IMFMediaType> outputType;
+    HRESULT hr = ::MFCreateMediaType(&outputType);
+    if (FAILED(hr)) {
+        recordError(hr, "MFCreateMediaType(video)");
+        return false;
+    }
+
+    outputType->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+    outputType->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_RGB32);
+    outputType->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+    outputType->SetUINT32(MF_MT_ALL_SAMPLES_INDEPENDENT, TRUE);
+    MFSetAttributeSize(outputType.get(), MF_MT_FRAME_SIZE, width, height);
+    // A positive stride asks for top-down rows. Most transformations honour it and it
+    // saves a row flip per frame; publishFrame() still copes if the reader ignores it.
+    outputType->SetUINT32(MF_MT_DEFAULT_STRIDE, width * 4);
+
+    UINT32 parNumerator = 1;
+    UINT32 parDenominator = 1;
+    if (SUCCEEDED(MFGetAttributeRatio(nativeType, MF_MT_PIXEL_ASPECT_RATIO, &parNumerator, &parDenominator)))
+        MFSetAttributeRatio(outputType.get(), MF_MT_PIXEL_ASPECT_RATIO, parNumerator, parDenominator);
+
+    hr = state.reader->SetCurrentMediaType(streamIndex, nullptr, outputType.get());
+    if (FAILED(hr)) {
+        recordError(hr, "SetCurrentMediaType(video RGB32)");
+        return false;
+    }
+
+    state.reader->SetStreamSelection(streamIndex, TRUE);
+    state.hasVideo = true;
+    state.videoStreamIndex = streamIndex;
+    state.videoSize = IntSize { static_cast<int>(width), static_cast<int>(height) };
+    state.videoStride = static_cast<int>(width) * 4;
+
+    // Read back what the reader actually settled on: the stride may still be negative
+    // (bottom-up) even though a positive one was requested.
+    COMPtr<IMFMediaType> currentType;
+    if (SUCCEEDED(state.reader->GetCurrentMediaType(streamIndex, &currentType))) {
+        UINT32 strideAttribute = 0;
+        if (SUCCEEDED(currentType->GetUINT32(MF_MT_DEFAULT_STRIDE, &strideAttribute)))
+            state.videoStride = static_cast<int>(strideAttribute);
+
+        UINT32 currentWidth = 0;
+        UINT32 currentHeight = 0;
+        if (SUCCEEDED(MFGetAttributeSize(currentType.get(), MF_MT_FRAME_SIZE, &currentWidth, &currentHeight)) && currentWidth && currentHeight)
+            state.videoSize = IntSize { static_cast<int>(currentWidth), static_cast<int>(currentHeight) };
+    }
+
+    WinUWPMediaDiagnostics::recordVideoTypes(nativeSubtype.Data1, MFVideoFormat_RGB32.Data1, state.dxvaDisabled);
+
+    state.videoIsBottomUp = state.videoStride < 0;
+    m_naturalWidth.store(state.videoSize.width());
+    m_naturalHeight.store(state.videoSize.height());
+    return true;
+}
+
+bool MediaPlayerPrivateWinUWP::configureAudioStream(DecoderState& state, unsigned streamIndex, IMFMediaType* nativeType)
+{
+    UINT32 channels = MFGetAttributeUINT32(nativeType, MF_MT_AUDIO_NUM_CHANNELS, 0);
+    UINT32 sampleRate = MFGetAttributeUINT32(nativeType, MF_MT_AUDIO_SAMPLES_PER_SECOND, 0);
+    if (!channels || !sampleRate)
+        return false;
+
+    // Two channels is all the device needs and keeps the queue cheap; anything wider is
+    // downmixed by the reader's audio converter.
+    const int outputChannels = channels > 2 ? 2 : static_cast<int>(channels);
+
+    auto makeOutputType = [&](const GUID& subtype, unsigned bytesPerSample) -> COMPtr<IMFMediaType> {
+        COMPtr<IMFMediaType> type;
+        if (FAILED(::MFCreateMediaType(&type)))
+            return nullptr;
+        type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Audio);
+        type->SetGUID(MF_MT_SUBTYPE, subtype);
+        type->SetUINT32(MF_MT_AUDIO_NUM_CHANNELS, static_cast<UINT32>(outputChannels));
+        type->SetUINT32(MF_MT_AUDIO_SAMPLES_PER_SECOND, sampleRate);
+        type->SetUINT32(MF_MT_AUDIO_BLOCK_ALIGNMENT, static_cast<UINT32>(outputChannels) * bytesPerSample);
+        type->SetUINT32(MF_MT_AUDIO_AVG_BYTES_PER_SECOND, static_cast<UINT32>(outputChannels) * bytesPerSample * sampleRate);
+        type->SetUINT32(MF_MT_ALL_SAMPLES_INDEPENDENT, TRUE);
+        return type;
+    };
+
+    // Float32 is what the sink's queue is built for and what AAC decoders emit natively.
+    bool isFloat = true;
+    HRESULT hr = E_FAIL;
+    if (auto floatType = makeOutputType(MFAudioFormat_Float, sizeof(float)))
+        hr = state.reader->SetCurrentMediaType(streamIndex, nullptr, floatType.get());
+
+    if (FAILED(hr)) {
+        // Fall back to 16-bit PCM and convert on the way into the queue: some decoders and
+        // containers only offer integer output.
+        isFloat = false;
+        auto pcmType = makeOutputType(MFAudioFormat_PCM, sizeof(int16_t));
+        if (!pcmType) {
+            recordError(E_FAIL, "MFCreateMediaType(audio)");
+            return false;
+        }
+        hr = state.reader->SetCurrentMediaType(streamIndex, nullptr, pcmType.get());
+        if (FAILED(hr)) {
+            recordError(hr, "SetCurrentMediaType(audio)");
+            return false;
+        }
+    }
+
+    state.reader->SetStreamSelection(streamIndex, TRUE);
+    state.hasAudio = true;
+    state.audioStreamIndex = streamIndex;
+    state.audioIsFloat = isFloat;
+
+    {
+        Locker locker { m_lock };
+        m_audioSampleRate = static_cast<int>(sampleRate);
+        m_audioChannels = outputChannels;
+        m_audioAnchorMedia = MediaTime::zeroTime();
+    }
+
+    if (auto sink = winUWPMediaAudioSink())
+        sink->configure(static_cast<int>(sampleRate), outputChannels);
+
+    return true;
+}
+
+// ===========================================================================
+// Decode loop
+// ===========================================================================
+
+void MediaPlayerPrivateWinUWP::decodeLoop(DecoderState& state)
+{
+    bool prerolled = false;
+
+    while (true) {
+        // Move-construct rather than assign: NativePromiseProducer is move-constructible but
+        // std::optional's assignment operators are deleted for it under MSVC.
+        std::optional<MediaTimePromise::Producer> seekProducer;
+        MediaTime seekTime;
+        bool haveSeek = false;
+        bool preroll = false;
+
+        {
+            Locker locker { m_lock };
+            if (m_stopRequested)
+                return;
+
+            // A pending seek does not always have a promise behind it: play() on an ended
+            // element seeks back to the start with nobody waiting on it. It must still be
+            // performed - and it must be performed *before* the end-of-stream park below,
+            // or restarting an ended video would park here forever.
+            if (m_seekPending) {
+                m_seekPending = false;
+                seekTime = m_seekRequest;
+                haveSeek = true;
+                if (m_seekProducer) {
+                    seekProducer.emplace(WTF::move(*m_seekProducer));
+                    m_seekProducer.reset();
+                }
+            } else if (m_paused) {
+                if (!prerolled && state.hasVideo && !state.eos) {
+                    // Decode exactly one frame so the element has something to show before
+                    // playback starts (its poster frame), then go back to sleeping. This
+                    // is what keeps <video> from staying blank until the user hits play.
+                    prerolled = true;
+                    preroll = true;
+                } else {
+                    m_condition.waitFor(m_lock, idleParkInterval);
+                    continue;
+                }
+            }
+        }
+
+        if (haveSeek) {
+            const bool ok = performSeek(state, seekTime);
+            // The seek dropped the frame we had, so a paused player has to preroll again or
+            // it would show nothing at the new position.
+            prerolled = false;
+            if (seekProducer) {
+                if (ok)
+                    seekProducer->resolve(seekTime);
+                else
+                    seekProducer->reject(PlatformMediaError::InvalidState);
+            }
+            continue;
+        }
+
+        if (preroll) {
+            decodeOneSample(state, false);
+            continue;
+        }
+
+        if (state.failed || !state.reader) {
+            // Nothing will ever be readable on this reader again. Parking (instead of
+            // retrying) is what keeps a dead stream from spinning this thread at 100% CPU
+            // for the rest of the page's life.
+            Locker locker { m_lock };
+            if (m_stopRequested)
+                return;
+            m_condition.waitFor(m_lock, idleParkInterval);
+            continue;
+        }
+
+        if (state.eos) {
+            // Parked by noteEndOfStream(), which is what lets play() restart playback from
+            // the beginning. Waiting keeps the stop request answerable.
+            Locker locker { m_lock };
+            if (m_stopRequested)
+                return;
+            m_condition.waitFor(m_lock, idleParkInterval);
+            continue;
+        }
+
+        decodeOneSample(state, true);
+    }
+}
+
+bool MediaPlayerPrivateWinUWP::performSeek(DecoderState& state, MediaTime time)
+{
+    if (!state.reader)
+        return false;
+
+    // Drop everything the reader has queued, then reposition. Flushing also clears the
+    // end-of-stream flag, which is how a restart-after-end resumes.
+    HRESULT hr = state.reader->Flush(MF_SOURCE_READER_ALL_STREAMS);
+    if (FAILED(hr))
+        recordError(hr, "Flush");
+
+    PROPVARIANT position;
+    PropVariantInit(&position);
+    position.vt = VT_I8;
+    position.hVal.QuadPart = static_cast<__int64>(time.toDouble() * tenMegahertz);
+    hr = state.reader->SetCurrentPosition(GUID_NULL, position);
+    PropVariantClear(&position);
+    if (FAILED(hr)) {
+        recordError(hr, "SetCurrentPosition");
+        return false;
+    }
+
+    state.eos = false;
+
+    // The device queue still holds audio from before the seek, so it has to be dropped too.
+    if (auto sink = winUWPMediaAudioSink())
+        sink->reset();
+
+    {
+        Locker locker { m_lock };
+        m_eosVideo = false;
+        m_eosAudio = false;
+        m_audioAnchorMedia = time;
+        m_currentTime = time;
+        m_clockAnchorMedia = time;
+        m_clockAnchorWall = MonotonicTime::now().secondsSinceEpoch().value();
+    }
+
+    // Drop any frame that belonged to the pre-seek position.
+    {
+        Locker locker { m_frameLock };
+        m_havePresentableFrame = false;
+    }
+
+    m_reachedEnd.store(false);
+    notifySeekFinished();
+    return true;
+}
+
+bool MediaPlayerPrivateWinUWP::decodeOneSample(DecoderState& state, bool respectPacing)
+{
+    if (!state.reader)
+        return false;
+
+    DWORD actualStreamIndex = 0;
+    DWORD streamFlags = 0;
+    LONGLONG timestamp = 0;
+    COMPtr<IMFSample> sample;
+
+    HRESULT hr = state.reader->ReadSample(MF_SOURCE_READER_ANY_STREAM, 0, &actualStreamIndex, &streamFlags, &timestamp, &sample);
+    if (FAILED(hr)) {
+        // MF_E_INVALIDREQUEST after a stop and E_ABORT from a cancelled read are both
+        // ordinary consequences of tearing down; anything else is worth reporting.
+        if (hr != MF_E_INVALIDREQUEST && hr != E_ABORT)
+            recordError(hr, "ReadSample");
+        return false;
+    }
+
+    if (streamFlags & MF_SOURCE_READERF_ERROR) {
+        state.failed = true;
+        postFailure(MediaPlayer::NetworkState::DecodeError, "MF_SOURCE_READERF_ERROR");
+        return false;
+    }
+
+    if (streamFlags & MF_SOURCE_READERF_ENDOFSTREAM) {
+        noteEndOfStream(state, actualStreamIndex);
+        return false;
+    }
+
+    // A stream tick carries a timestamp but no sample: it marks a gap in a stream, not
+    // content, and the clock here is wall-clock driven, so there is nothing to do with it.
+    if (!sample || (streamFlags & MF_SOURCE_READERF_STREAMTICK))
+        return true;
+
+    if (state.hasVideo && actualStreamIndex == state.videoStreamIndex) {
+        if (respectPacing)
+            waitUntilDue(MediaTime(timestamp, tenMegahertz));
+        handleVideoSample(state, sample.get(), timestamp);
+        return true;
+    }
+
+    if (state.hasAudio && actualStreamIndex == state.audioStreamIndex) {
+        handleAudioSample(state, sample.get(), timestamp);
+        return true;
+    }
+
+    return true;
+}
+
+void MediaPlayerPrivateWinUWP::waitUntilDue(MediaTime due)
+{
+    while (true) {
+        MediaTime now;
+        {
+            Locker locker { m_lock };
+            if (m_stopRequested || m_paused)
+                return;
+            now = clockNowLocked();
+        }
+
+        double ahead = (due - now).toDouble();
+        if (ahead <= presentationLeadSeconds)
+            return;
+        sleepForSeconds(ahead - presentationLeadSeconds);
+    }
+}
+
+void MediaPlayerPrivateWinUWP::handleVideoSample(DecoderState& state, IMFSample* sample, LONGLONG timestamp)
+{
+    (void)timestamp;
+
+    COMPtr<IMFMediaBuffer> buffer;
+    if (FAILED(sample->ConvertToContiguousBuffer(&buffer)) || !buffer)
+        return;
+
+    BYTE* data = nullptr;
+    DWORD maximumLength = 0;
+    DWORD currentLength = 0;
+    if (FAILED(buffer->Lock(&data, &maximumLength, &currentLength))) {
+        recordError(E_FAIL, "IMFMediaBuffer::Lock");
+        return;
+    }
+
+    if (currentLength)
+        publishFrame(data, state.videoStride, state.videoSize);
+
+    buffer->Unlock();
+
+    // Every frame, so the page keeps being asked to repaint for as long as the video runs
+    // (the notification itself decides whether this was the first frame).
+    notifyFrameReady();
+}
+
+void MediaPlayerPrivateWinUWP::handleAudioSample(DecoderState& state, IMFSample* sample, LONGLONG timestamp)
+{
+    auto sink = winUWPMediaAudioSink();
+    if (!sink)
+        return;
+
+    COMPtr<IMFMediaBuffer> buffer;
+    if (FAILED(sample->ConvertToContiguousBuffer(&buffer)) || !buffer)
+        return;
+
+    BYTE* data = nullptr;
+    DWORD maximumLength = 0;
+    DWORD currentLength = 0;
+    if (FAILED(buffer->Lock(&data, &maximumLength, &currentLength))) {
+        recordError(E_FAIL, "IMFMediaBuffer::Lock(audio)");
+        return;
+    }
+
+    int channels;
+    float volume;
+    bool muted;
+    {
+        Locker locker { m_lock };
+        channels = m_audioChannels;
+        volume = m_volume;
+        muted = m_muted;
+    }
+
+    if (channels > 0 && currentLength) {
+        const unsigned bytesPerSample = state.audioIsFloat ? sizeof(float) : sizeof(int16_t);
+        const size_t sampleCount = currentLength / bytesPerSample;
+        const int frames = static_cast<int>(sampleCount / static_cast<unsigned>(channels));
+
+        if (frames > 0) {
+            m_scratch.resize(sampleCount);
+            float* destination = m_scratch.mutableSpan().data();
+            const float gain = muted ? 0.0f : volume;
+
+            if (state.audioIsFloat) {
+                const float* source = reinterpret_cast<const float*>(data);
+                for (size_t i = 0; i < sampleCount; ++i)
+                    destination[i] = source[i] * gain;
+            } else {
+                const int16_t* source = reinterpret_cast<const int16_t*>(data);
+                for (size_t i = 0; i < sampleCount; ++i)
+                    destination[i] = (static_cast<float>(source[i]) / 32768.0f) * gain;
+            }
+
+            // The sink is bounded; pushing only what fits and dropping the rest would
+            // desync audio from video permanently, so a full queue is treated as
+            // back-pressure and the decoder waits for the device instead.
+            const size_t channelCount = static_cast<size_t>(channels);
+            size_t framesPushed = 0;
+            while (framesPushed < static_cast<size_t>(frames)) {
+                {
+                    Locker locker { m_lock };
+                    if (m_stopRequested || m_paused)
+                        break;
+                }
+
+                const int remaining = static_cast<int>(static_cast<size_t>(frames) - framesPushed);
+                const int queued = sink->pushPCM(destination + framesPushed * channelCount, remaining);
+                if (queued <= 0) {
+                    sleepForSeconds(0.005);
+                    continue;
+                }
+
+                g_pcmFramesPushed.fetch_add(static_cast<unsigned long long>(queued));
+                {
+                    Locker locker { m_lock };
+                    m_audioAnchorMedia = MediaTime(timestamp, tenMegahertz);
+                }
+                framesPushed += static_cast<size_t>(queued);
+            }
+
+            if (framesPushed < static_cast<size_t>(frames))
+                g_pcmFramesDropped.fetch_add(static_cast<unsigned long long>(frames - framesPushed));
+        }
+    }
+
+    buffer->Unlock();
+}
+
+void MediaPlayerPrivateWinUWP::noteEndOfStream(DecoderState& state, unsigned streamIndex)
+{
+    bool allEnded;
+    {
+        Locker locker { m_lock };
+        if (state.hasVideo && streamIndex == state.videoStreamIndex)
+            m_eosVideo = true;
+        else if (state.hasAudio && streamIndex == state.audioStreamIndex)
+            m_eosAudio = true;
+
+        // A stream we never selected reporting end-of-stream must not end playback.
+        const bool videoDone = !state.hasVideo || m_eosVideo;
+        const bool audioDone = !state.hasAudio || m_eosAudio;
+        allEnded = videoDone && audioDone;
+
+        if (allEnded) {
+            // Ending is a pause: play() on an ended element is expected to restart it, and
+            // play() keys that off m_reachedEnd.
+            m_currentTime = clockNowLocked();
+            m_paused = true;
+        }
+    }
+
+    if (!allEnded)
+        return;
+
+    state.eos = true;
+    m_reachedEnd.store(true);
+    notifyPlaybackEnded();
+}
+
+// ===========================================================================
+// Media engine registration
+// ===========================================================================
+
+void MediaPlayerPrivateWinUWP::getSupportedTypes(HashSet<String>& types)
+{
+    types = winUWPMediaSupportedTypes();
+}
+
+MediaPlayer::SupportsType MediaPlayerPrivateWinUWP::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    // MSE and MediaStream have no backend here; saying "maybe" would make the element wait
+    // for source buffers or tracks that can never arrive.
+    if (parameters.platformType != PlatformMediaDecodingType::FileOrHLS)
+        return MediaPlayer::SupportsType::IsNotSupported;
+
+    if (parameters.requiresRemotePlayback)
+        return MediaPlayer::SupportsType::IsNotSupported;
+
+    auto containerType = parameters.type.containerType();
+    if (containerType.isEmpty())
+        return MediaPlayer::SupportsType::MayBeSupported;
+
+    if (!winUWPMediaSupportedTypes().contains(containerType))
+        return MediaPlayer::SupportsType::IsNotSupported;
+
+    // The container is one we can open, but without asking Media Foundation to build a
+    // decoder we cannot promise the codecs inside it are decodable.
+    if (parameters.type.codecs().isEmpty())
+        return MediaPlayer::SupportsType::IsSupported;
+
+    return MediaPlayer::SupportsType::MayBeSupported;
+}
+
+class MediaPlayerFactoryWinUWP final : public MediaPlayerFactory {
+private:
+    // This engine is Media Foundation; the identifier is upstream's and is used for
+    // diagnostics and engine ordering, so there is no separate value to invent.
+    MediaPlayerEnums::MediaEngineIdentifier identifier() const final { return MediaPlayerEnums::MediaEngineIdentifier::MediaFoundation; }
+
+    Ref<MediaPlayerPrivateInterface> createMediaEnginePlayer(MediaPlayer& player) const final
+    {
+        return adoptRef(*new MediaPlayerPrivateWinUWP(player));
+    }
+
+    void getSupportedTypes(HashSet<String>& types) const final
+    {
+        MediaPlayerPrivateWinUWP::getSupportedTypes(types);
+    }
+
+    MediaPlayer::SupportsType supportsTypeAndCodecs(const MediaEngineSupportParameters& parameters) const final
+    {
+        return MediaPlayerPrivateWinUWP::supportsType(parameters);
+    }
+};
+
+void MediaPlayerPrivateWinUWP::registerMediaEngine(MediaEngineRegistrar registrar)
+{
+    registrar(makeUnique<MediaPlayerFactoryWinUWP>());
+}

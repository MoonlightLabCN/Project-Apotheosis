+    : public MediaPlayerPrivateInterface
+    , public ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr<MediaPlayerPrivateWinUWP, WTF::DestructionThread::Main> {
+    WTF_MAKE_TZONE_ALLOCATED(MediaPlayerPrivateWinUWP);
+    using RefCountedBase = ThreadSafeRefCountedAndCanMakeThreadSafeWeakPtr<MediaPlayerPrivateWinUWP, WTF::DestructionThread::Main>;
+public:
+    // MediaPlayerPrivateInterface derives from AbstractRefCounted, whose ref()/deref() are pure;
+    // every subclass picks its own ref-counting base (see the comment on MediaPlayerPrivateInterface).
+    //
+    // Thread-safe WEAK refcounting, and this is load-bearing rather than a preference: the decode
+    // thread must never take a STRONG reference to this object. If it does, the engine thread can
+    // drop the last strong reference and enter ~MediaPlayerPrivateWinUWP() - whose first act is to
+    // join the decode thread - while that thread is still running; a strong ref taken there lands on
+    // an object whose destructor has already begun, and the resulting second delete trips
+    // RELEASE_ASSERT(m_refCount == 1) in ~RefCountedBase(). An earlier revision did exactly that.
+    // A ThreadSafeWeakPtr outlives the object, so resolving one after death is safe and yields null.
+    void ref() const final { RefCountedBase::ref(); }
